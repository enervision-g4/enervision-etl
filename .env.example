# Ce depot porte les deux extremites de la chaine, et la meme image sert aux trois
# roles : le collecteur, le consumer de persistance et celui d'alerting. Chaque section
# ci-dessous indique qui lit quoi.

# ============================================================
# Commun aux trois services
# ============================================================
LOG_LEVEL=INFO
LOG_AS_JSON=true

# Adresse du broker. Le collecteur ne l'exige que si PUBLISHER_TARGET vaut kafka ;
# les consumers l'exigent toujours, ils n'ont pas d'autre source.
KAFKA_BOOTSTRAP_SERVERS=

# Un topic par table du MCD : la destination de chaque message se lit sans
# documentation. KAFKA_TOPIC_SITE doit etre cree avec cleanup.policy=compact.
KAFKA_TOPIC_SITE=enervision.site
KAFKA_TOPIC_MEASURE_RAW=enervision.measure_raw
KAFKA_TOPIC_MEASURE_IMPUTED=enervision.measure_imputed
KAFKA_TOPIC_ALERT=enervision.alert

# ============================================================
# Collecteur : enervision-etl collect-realtime / backfill
# ============================================================
API_MOCK_BASE_URL=http://CHANGEME:8000
API_MOCK_TIMEOUT_SECONDS=5
API_MOCK_SOURCE_TIMEZONE=UTC
# L'instance mock se degrade quand on l'interroge en rafale : elle renvoie alors des
# series entierement nulles. Cet espacement minimal entre requetes protege la mesure.
API_MOCK_MIN_REQUEST_INTERVAL_SECONDS=0.2

POLL_INTERVAL_SECONDS=60
SITE_REFRESH_INTERVAL_SECONDS=3600
# Vide ou ALL : recupere tous les sites de l'endpoint /sites, sinon seulement ceux
# indiques.
SITES=ALL
#SITES=SITE001,SITE002,SITE003

# stdout pour developper sans broker, kafka pour publier reellement.
PUBLISHER_TARGET=stdout
IMPUTATION_MAX_GAP_MEASURES=3
METRICS_PORT=8001

# ============================================================
# Consumers : enervision-consumer consume-persistence / consume-alerting
# ============================================================
# Base de destination. Les schemas postgres:// et postgresql:// sont acceptes.
DATABASE_URL=postgres://CHANGEME:CHANGEME@CHANGEME:5432/g4_db

# A LAISSER VIDE dans un fichier partage. Chaque service a son propre defaut
# (enervision-consumer-persistence et enervision-consumer-alerting) : renseigner cette
# variable ici les mettrait tous les deux dans le meme groupe, ou ils se partageraient
# le topic des sites au lieu de le recevoir chacun en entier. Ne la definir que par
# conteneur, et seulement pour repartir la charge entre plusieurs instances d'un meme
# service.
#KAFKA_CONSUMER_GROUP=
